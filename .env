################# Oracle 23ai
ORA_USER=sunafil
ORA_PASSWORD=sunafil
ORA_DSN=localhost:1521/FREEPDB1

################# Clasificador
CLASSIFIER_MODE=finetuned
FT_MODEL_PATH=ft-model-xlmr
FT_TOKENIZER=xlm-roberta-base

################# Flujo
CONFIDENCE_METRIC=softmax
# calibrado con ft-model-xlmr: 0.90 -> 64% ruta rapida con 92.4% de acierto
CONFIDENCE_THRESHOLD=0.90
TOP_K=5

################# Embeddings (nomic ingles-full: medicion de control)
EMBEDDING_MODEL=nomic-ai/modernbert-embed-base
EMBEDDING_DIM=768
EMBED_DOC_PREFIX=search_document:
EMBED_QUERY_PREFIX=search_query:
FORCE_HASH_EMBEDDING=0

################# LLM (Ollama)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3:8b-instruct-q4_K_M
USE_MOCK_LLM=0
